+    def _cpu_decode(self, hidden_states, topk_weights, topk_ids):
+        stream_ptr = torch.cuda.current_stream().cuda_stream
+        self.lk_moe.cpu_decode(
+            stream_ptr,
+            hidden_states.size(0),
